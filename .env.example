# Copy this file to .env (docker compose loads .env automatically) and
# fill in real values before running `docker compose up`.

# REQUIRED. Absolute path on the HOST machine to your Claude Code history
# directory. Must be absolute - Docker Compose does not reliably expand
# `~` or nested `${HOME}` inside compose files, so this is required with
# no default (docker compose will fail with a clear error if it's unset).
#   Linux:   CLAUDE_HISTORY_SOURCE=/home/YOUR_USERNAME/.claude/projects
#   macOS:   CLAUDE_HISTORY_SOURCE=/Users/YOUR_USERNAME/.claude/projects
CLAUDE_HISTORY_SOURCE=/home/YOUR_USERNAME/.claude/projects

# OpenObserve root credentials - used both to start OpenObserve itself and
# for the ingestor app to authenticate against it. Change the password
# for anything beyond local/throwaway use.
OPENOBSERVE_USER=root@example.com
OPENOBSERVE_PASSWORD=Complexpass#123
